  orgId: string,
  slug:  string,
  input: UpdateAssistantConfigInput,
) =>
  chatIaFetch<{ data: AssistantConfig }>(`/projects/${slug}/assistant/config`, orgId, {
    method: 'PUT',
    body:   JSON.stringify(input),
  });

