  chatIaFetch<{ data: ProyectoIA[] }>('/projects', orgId);

export const createProyectoIA = (orgId: string, input: CreateProyectoInput) =>
  chatIaFetch<{ data: ProyectoIA }>('/projects', orgId, {
    method: 'POST',
    body:   JSON.stringify(input),
  });

// ── Configuración del Asistente ───────────────────────────────────────────────

