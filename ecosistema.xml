        <footer className="border-t border-border mt-16 py-8 text-center text-sm text-muted-foreground">
          {t(dict.store.poweredBy, { store: storeName })}
        </footer>
      </div>

      <JsonLd
        data={storeJsonLd({
          name:        storeName,
          url:         `/${locale}/tienda/${slug}`,
