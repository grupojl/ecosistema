COPY --from=builder --chown=nextjs:nodejs /app/realsass-sass-front/package.json ./realsass-sass-front/package.json
USER nextjs
EXPOSE 3000
WORKDIR /app/realsass-sass-front
CMD ["../node_modules/.bin/next", "start"]
