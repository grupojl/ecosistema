                    <span className="text-muted-foreground">Envío</span>
                    <span>${mockCart.shipping.toFixed(2)}</span>
                  </div>
                  <Separator />
                  <div className="flex justify-between font-bold text-lg">
                    <span>Total</span>
                    <span>${mockCart.total.toFixed(2)}</span>
