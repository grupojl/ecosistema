<file path="realsass-sass-back/prisma/schema.prisma">
// =============================================================================
// prisma/schema.prisma — real-back (post S1 + ADR-013 superadmin integration)
// =============================================================================

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum CollaboratorStatus {
  PENDING
  ACTIVE
  REMOVED
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum StoreStatus {
  ACTIVE
  PAUSED
}

// ─── Modelos ──────────────────────────────────────────────────────────────────

model User {
  id             String   @id @default(uuid())
  firebaseUid    String   @unique
  email          String   @unique
  isOwner        Boolean  @default(false)
  isAffiliate    Boolean  @default(false)
  affiliateCode  String?  @unique
  referredByCode String?
  displayName    String?
  avatarUrl      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization?
  affiliateData  AffiliateData?
  collaborations Collaborator[]

  @@map("users")
}

model Organization {
  id          String  @id @default(uuid())
  userId      String  @unique
  name        String?
  description String?
  logoUrl     String?
  website     String?
  phone       String?
  address     String?
  slug        String? @unique
  enabledProducts Json @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ── Integración superadmin (ADR-013) ──────────────────────────────────────
  // status      → controla acceso al panel administrativo (TenantGuard)
  // storeStatus → controla visibilidad del storefront público (StoreService)
  // Son independientes — dos dimensiones de control (norte Shopify Partners)
  ecosystemId  String      @default("welver")
  plan         String      @default("free")
  status       OrgStatus   @default(ACTIVE)
  suspendedAt  DateTime?
  storeStatus  StoreStatus @default(ACTIVE)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  collaborators Collaborator[]
  themes        ThemeConfig[]
  secrets       SecretConfig[]
  flags         FeatureFlag[]
  templates     ContentTemplate[]
  quotas        QuotaConfig[]
  webhooks      WebhookEndpoint[]
  configAudit   ConfigAuditLog[]

  @@map("organizations")
}

model Collaborator {
  id             String             @id @default(uuid())
  organizationId String
  userId         String?
  email          String
  status         CollaboratorStatus @default(PENDING)
  permissions    Json               @default("{}")
  invitedAt      DateTime           @default(now())
  acceptedAt     DateTime?
  updatedAt      DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  invitation   Invitation?

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([userId])
  @@map("collaborators")
}

