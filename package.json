{
  "name": "welver",
  "private": true,
  "version": "0.0.0",
  "description": "Ecosistema Real — pnpm workspaces",
  "scripts": {
    "check:types-safety": "node scripts/check-type-safety.mjs --check",
    "contracts": "pnpm --filter realsass-sass-back exec prisma generate && pnpm --filter realsass-ecommerce-back exec prisma generate && pnpm --filter @real/trpc build",
    "build": "pnpm --filter \"./packages/*\" build && pnpm --recursive --filter \"./realsass-*\" --filter \"./real-*\" build",
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "dev": "node scripts/dev.mjs",
    "dev:parallel": "pnpm --parallel --filter realsass-sass-back --filter realsass-ecommerce-back --filter realsass-sass-front --filter realsass-dashboard-front --filter real-ecommerce-front --filter realsass-docs-front --filter realsass-design-front dev",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --recursive test",
    "ui:check": "node scripts/ui-migrate.mjs check",
    "ui:migrate": "node scripts/ui-migrate.mjs apply",
    "ui:verify": "node scripts/ui-migrate.mjs verify",
    "ui:restore": "node scripts/ui-migrate.mjs restore",
    "ui:guard": "node scripts/ui-migrate.mjs guard",
    "ui:lint": "node scripts/ui-migrate.mjs lint",
    "ui:snap": "node scripts/ui-snapshots.mjs update",
    "ui:snapcheck": "node scripts/ui-snapshots.mjs check",
    "ui:ci": "node scripts/ui-migrate.mjs guard && node scripts/ui-migrate.mjs check --strict",
    "env:check": "node scripts/check-env.mjs",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "firebase-tools": "catalog:",
    "typescript": "catalog:"
  }
}
