{
  "name": "welver",
  "private": true,
  "version": "0.0.0",
  "description": "Ecosistema Real — pnpm workspaces",
  "scripts": {
    "dev":           "pnpm --parallel --filter realsass-sass-back --filter realsass-ecommerce-back --filter realsass-sass-front --filter realsass-dashboard-front --filter real-ecommerce-front dev",
    "dev:back":      "pnpm --parallel --filter realsass-sass-back --filter realsass-ecommerce-back dev",
    "dev:front":     "pnpm --parallel --filter realsass-sass-front --filter realsass-dashboard-front --filter real-ecommerce-front dev",

    "dev:sass-back":   "pnpm --filter realsass-sass-back start:dev",
    "dev:ecom-back":   "pnpm --filter realsass-ecommerce-back start:dev",
    "dev:sass-front":  "pnpm --filter realsass-sass-front dev",
    "dev:dashboard":   "pnpm --filter realsass-dashboard-front dev",
    "dev:store":       "pnpm --filter real-ecommerce-front dev",

    "build":          "pnpm --filter './packages/*' build && pnpm --recursive --filter './realsass-*' --filter './real-*' build",
    "build:packages": "pnpm --filter './packages/*' build",

    "lint":      "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "test":      "pnpm --recursive test",

    "clean": "find . -name 'node_modules' -maxdepth 3 -type d -exec rm -rf {} + 2>/dev/null; find . -name 'dist' -maxdepth 3 -type d -exec rm -rf {} + 2>/dev/null; find . -name '.next' -maxdepth 3 -type d -exec rm -rf {} + 2>/dev/null; echo 'Limpio'",

    "docker:up":   "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
