{
  "name": "@real/i18n",
  "version": "0.0.0",
  "private": true,
  "description": "Idioma compartido de los paneles — idiomas activos, negociación por cookie, diccionario común y provider",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
