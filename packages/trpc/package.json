{
  "name": "@real/trpc",
  "version": "0.0.0",
  "private": true,
  "description": "Contratos tRPC compartidos — tipos de los routers de cada back, leídos desde dist/",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./markets": {
      "types": "./dist/markets.d.ts",
      "default": "./dist/markets.js"
    }
  },
  "typesVersions": {
    "*": {
      "markets": [
        "dist/markets.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/build.mjs"
  },
  "dependencies": {
    "@trpc/server": "catalog:",
    "superjson": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/node": "catalog:"
  }
}
