# ══════════════════════════════════════════════════════════════════════════════
# real-ecommerce-front — storefront público (tienda, catálogo, carrito, checkout)
# ══════════════════════════════════════════════════════════════════════════════
# Local:       cp .env.example .env.local   y completar los valores.
# Producción:  las NEXT_PUBLIC_* se cargan en Railway como **Build Variables** (no alcanza
#              con Runtime): Next.js las incrusta en el JavaScript al compilar. El
#              Dockerfile las recibe como ARG. SITE_URL y ECOMMERCE_BACK_URL son de
#              servidor y se leen en runtime.
#
# Este front NO usa Firebase ni autenticación de owner: el cliente del storefront se
# identifica por email (customer.identify) y manda su x-customer-id.
#
# Las URLs son la BASE del servicio, sin barra final y SIN /api/v1: los clientes tRPC
# agregan ellos mismos /api/v1/trpc.
#
# [REQUERIDA] la app no funciona si falta.
# [OPCIONAL]  la función asociada queda deshabilitada o usa un fallback.
# Los comentarios van en su propia línea (no al lado del valor).
# ══════════════════════════════════════════════════════════════════════════════


# ── Backend (tRPC) ────────────────────────────────────────────────────────────

# [REQUERIDA] URL pública de realsass-ecommerce-back, usada por el navegador
# (carrito, checkout). Se incrusta en el build.
NEXT_PUBLIC_ECOMMERCE_API_URL=http://localhost:3005

# [REQUERIDA, solo servidor] URL INTERNA de ecommerce-back para renderizar en el servidor
# (resolver la tienda por slug, catálogo, SEO). En Railway usar la red privada
# (ej: https://realsass-ecommerce-back.railway.internal). Si falta, usa
# NEXT_PUBLIC_ECOMMERCE_BACK_URL y, si tampoco está, el render de la tienda falla.
# Variable de runtime: no necesita ARG.
ECOMMERCE_BACK_URL=http://localhost:3005

# [OPCIONAL] Alternativa pública de ECOMMERCE_BACK_URL para el servidor. Preferir
# ECOMMERCE_BACK_URL; dejar comentada si esa está definida.
# NEXT_PUBLIC_ECOMMERCE_BACK_URL=http://localhost:3005

# [REQUERIDA para carrito y checkout] UUID de la organización dueña de esta tienda.
# Es la ÚNICA fuente del header x-organization-id en el navegador (lib/trpc/client.ts),
# y los procedures de carrito y checkout lo exigen: sin ella el cliente no puede comprar.
# Limitación de diseño: un mismo despliegue sirve UNA organización en el navegador.
# Para un storefront multi-tienda hay que resolverla por slug (deuda DT-ENV-03 en
# .claude/roadmap/deuda-tecnica.md).
NEXT_PUBLIC_ECOMMERCE_ORGANIZATION_ID=<COMPLETAR>


# ── SEO e i18n (ADR-016) ──────────────────────────────────────────────────────

# [REQUERIDA EN PRODUCCIÓN, solo servidor] URL pública del storefront con https, sin barra
# final. De ella salen el canonical, los hreflang, el sitemap y la línea Sitemap de
# robots.txt. Se lee en RUNTIME (se puede cambiar sin recompilar). Si falta o es inválida
# la app NO se rompe: omite canonical/hreflang/sitemap y deja un error en el log, porque
# un canonical a localhost sería peor que no tener ninguno.
SITE_URL=http://localhost:3003
