# ══════════════════════════════════════════════════════════════════════════════
# realsass-dashboard-front — panel de colaboradores (tienda, pedidos, config, chat IA)
# ══════════════════════════════════════════════════════════════════════════════
# Local:       cp .env.example .env.local   y completar los valores <COMPLETAR>.
# Producción:  cargar en Railway como **Build Variables** (no alcanza con Runtime):
#              Next.js incrusta las NEXT_PUBLIC_* en el JavaScript al compilar, así que
#              cambiarlas después del build no tiene efecto. El Dockerfile las recibe
#              como ARG. Las que NO llevan el prefijo NEXT_PUBLIC_ son de servidor y se
#              leen en runtime.
#
# Las URLs son la BASE del servicio, sin barra final y SIN /api/v1: los clientes tRPC
# agregan ellos mismos /api/v1/trpc.
#
# [REQUERIDA] la app no funciona si falta.
# [OPCIONAL]  la función asociada queda deshabilitada o usa un fallback.
# Los comentarios van en su propia línea (no al lado del valor).
# ══════════════════════════════════════════════════════════════════════════════


# ── Backends del monorepo (tRPC) ──────────────────────────────────────────────

# [REQUERIDA] URL pública de realsass-sass-back (auth, organizaciones, configuración).
# Es la que usan el AuthProvider y el cliente tRPC de sass-back.
NEXT_PUBLIC_REAL_BACK_URL=http://localhost:3000

# [OPCIONAL] Alias de la anterior (misma URL). Lo leen lib/api-client.ts y providers/.
# Mantenerla igual a NEXT_PUBLIC_REAL_BACK_URL hasta unificar los nombres
# (deuda DT-ENV-01 en .claude/roadmap/deuda-tecnica.md).
NEXT_PUBLIC_SASS_BACK_URL=http://localhost:3000

# [REQUERIDA] URL pública de realsass-ecommerce-back (productos, stock, pedidos).
NEXT_PUBLIC_ECOMMERCE_API_URL=http://localhost:3005

# [OPCIONAL, solo servidor] URL INTERNA de ecommerce-back para el prefetch de los Server
# Components (lib/trpc/server.ts). En Railway usar la red privada
# (ej: https://realsass-ecommerce-back.railway.internal). Si falta, usa
# NEXT_PUBLIC_ECOMMERCE_API_URL. Variable de runtime: no necesita ARG.
ECOMMERCE_BACK_URL=http://localhost:3005


# ── Otros fronts ──────────────────────────────────────────────────────────────

# [OPCIONAL] URL pública del storefront (real-ecommerce-front). Habilita el link
# "Ver tienda" del sidebar y la pantalla de Preview. Sin ella ambos quedan deshabilitados.
NEXT_PUBLIC_STORE_FRONT_URL=http://localhost:3003

# [OPCIONAL] URL de sass-front (panel del dueño). Reservada: hoy el código no la lee,
# pero el Dockerfile la declara como ARG.
NEXT_PUBLIC_SASS_FRONT_URL=http://localhost:3001


# ── Servicios fuera de este monorepo (puente REST, ADR-005) ───────────────────
# Todavía no tienen AppRouter en @real/trpc, por eso se llaman por HTTP directo
# (lib/api-client.ts y lib/chat-ia-client.ts). Se eliminan cuando tengan tRPC.

# [OPCIONAL] chat-ia-back. Sin ella /dashboard/chat no puede cargar conversaciones.
NEXT_PUBLIC_CHAT_IA_URL=http://localhost:3020

# [OPCIONAL] Servicio de campañas (ecosistema-ms). Sin ella /dashboard/campanas falla al consultar.
NEXT_PUBLIC_CAMPANAS_URL=http://localhost:3010

# [OPCIONAL] Servicio de pagos (pasarelapagos-backend de ecosistema-ms). Sin ella /dashboard/pagos falla al consultar.
NEXT_PUBLIC_PAGOS_URL=http://localhost:3011


# ── Firebase (cliente web) ────────────────────────────────────────────────────
# Firebase Console → Project settings → General → Your apps → Web app → SDK config.
# Mismo proyecto que usa sass-back para verificar los tokens.

# [REQUERIDA]
NEXT_PUBLIC_FIREBASE_API_KEY=<COMPLETAR>

# [OPCIONAL] Default <projectId>.firebaseapp.com.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<COMPLETAR>

# [REQUERIDA]
NEXT_PUBLIC_FIREBASE_PROJECT_ID=<COMPLETAR>

# [OPCIONAL] Default <projectId>.appspot.com.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=<COMPLETAR>

# [OPCIONAL]
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=<COMPLETAR>

# [OPCIONAL]
NEXT_PUBLIC_FIREBASE_APP_ID=<COMPLETAR>
