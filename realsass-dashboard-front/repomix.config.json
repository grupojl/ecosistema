{
  "$schema": "https://repomix.com/repomix-config.schema.json",
  "output": {
    "filePath": "real-dashboard-front.xml",
    "style": "markdown",
    "parsable": true,
    "topFilesLength": 5,
    "showLineNumbers": false,
    "copyToClipboard": false
  },
  "include": [
    "src/**/*",
    "app/**/*",
    "components/**/*",
    "package.json",
    "tsconfig.json",
    "next.config.mjs",
    "tailwind.config.ts",
    "components.json"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      ".next",
      "out",
      "build",
      "node_modules",
      ".pnpm-store",
      "pnpm-lock.yaml",
      "public/**/*",
      "*.log",
      ".env",
      ".env.*",
      "**/*.config.{js,ts,mjs}",
      "!next.config.mjs",
      "!tailwind.config.ts",
      "components/ui/**/*"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  }
}