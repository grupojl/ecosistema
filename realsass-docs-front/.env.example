# ══════════════════════════════════════════════════════════════════════════════
# realsass-docs-front — documentación pública del ecosistema
# ══════════════════════════════════════════════════════════════════════════════
# Local: cp .env.example .env.local
# El contenido lo edita el superadmin y este front lo lee de su backend (ADR-020/021).
# Ninguna variable es NEXT_PUBLIC_ salvo la URL pública: la clave interna es solo de servidor.
#
# [REQUERIDA] la app no funciona si falta.
# [OPCIONAL]  la función asociada usa un fallback.
# ══════════════════════════════════════════════════════════════════════════════

# [REQUERIDA] URL base de grupojl-control-backend, sin barra final.
# Local: http://localhost:3001 · Railway: red privada (…railway.internal:<PORT>).
DOCS_BACKEND_URL=http://localhost:3001

# [REQUERIDA] Mismo valor que INTERNAL_API_KEY del superadmin. Se envía como
# x-internal-api-key al leer /internal/docs/* y se exige en POST /api/revalidate.
INTERNAL_API_KEY=<COMPLETAR>

# [OPCIONAL] Ecosistema cuyas docs sirve ESTE deploy (ADR-021). Debe existir en
# ECOSYSTEM_IDS de superadmin. Default: welver.
DOCS_ECOSYSTEM_ID=welver

# [OPCIONAL] URL pública de este front (canonical y metadataBase).
NEXT_PUBLIC_DOCS_URL=http://localhost:3024
