# ══════════════════════════════════════════════════════════════════════════════
# realsass-ecommerce-back — catálogo, inventario, carrito, órdenes y clientes
# ══════════════════════════════════════════════════════════════════════════════
# Local:       cp .env.example .env   y completar los valores <COMPLETAR>.
# Producción:  cargar estas variables en Railway (Variables del servicio).
#              NUNCA commitear el .env.
#
# [REQUERIDA] el servicio no arranca, o falla al primer uso, si falta.
# [OPCIONAL]  tiene un valor por defecto; se muestra el default.
#
# Los comentarios van en su propia línea (no al lado del valor): `docker --env-file`
# no soporta comentarios en línea y los tomaría como parte del valor.
# ══════════════════════════════════════════════════════════════════════════════


# ── Aplicación ────────────────────────────────────────────────────────────────

# [OPCIONAL] Entorno. En "production" los logs salen en JSON y el nivel por defecto es "info".
NODE_ENV=development

# [OPCIONAL] Puerto HTTP. Default 3025 (también en la imagen Docker); Railway inyecta el suyo.
PORT=3025

# [REQUERIDA] Orígenes permitidos por CORS, separados por coma y SIN barra final (storefront y dashboard).
# Sin ella el servicio NO arranca (falla cerrado). "*" tampoco se acepta: se usan credenciales.
# Un storefront con dominio propio se agrega acá.
ALLOWED_ORIGINS=http://localhost:3022,http://localhost:3023

# [OPCIONAL] Saltos de proxy confiables para leer la IP real (rate limit). Default: 1 en producción
# (Railway) y 0 en local. Con 0 detrás de un proxy, todos los clientes comparten una sola IP.
# TRUST_PROXY=1

# [REQUERIDA] Secreto con el que se FIRMA la sesión del cliente del storefront (x-customer-token).
# Mínimo 32 caracteres:  openssl rand -hex 32
# Admite varios separados por coma para rotar sin cerrar sesiones: CUSTOMER_SESSION_SECRET=nuevo,viejo
# (firma con el primero, verifica con todos). Sin él el servicio NO arranca.
CUSTOMER_SESSION_SECRET=<COMPLETAR>

# [OPCIONAL] Nivel de log de pino: trace | debug | info | warn | error.
# Default: debug fuera de producción, info en producción.
LOG_LEVEL=debug


# ── Base de datos ─────────────────────────────────────────────────────────────

# [REQUERIDA] PostgreSQL de este servicio. Lo lee la app y prisma.config.ts
# (prisma migrate deploy corre en el entrypoint del contenedor antes de arrancar).
# Cada servicio tiene su PROPIA base: no compartir con sass-back.
#
# ADR-027 (Row Level Security): en producción DATABASE_URL tiene que ser el rol de aplicación `eco_app`
# (sin SUPERUSER ni BYPASSRLS; se crea con prisma/rls/app-role.sql). Con un superusuario las políticas NO se
# aplican y, con NODE_ENV=production, el servicio se niega a arrancar. En desarrollo local un superusuario solo avisa.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/realsass_ecommerce?schema=public

# [OPCIONAL] Dueño de las tablas, solo para `prisma migrate deploy` (entrypoint). Si no está, se usa DATABASE_URL.
# En producción: MIGRATION_DATABASE_URL = el dueño del esquema; DATABASE_URL = eco_app.
# MIGRATION_DATABASE_URL=postgresql://dueno:clave@localhost:5432/base?schema=public

# [OPCIONAL] true = permite arrancar en producción con un rol SUPERUSER/BYPASSRLS (RLS no se aplica). Solo para entornos
# efímeros; nunca en producción real.
# ALLOW_RLS_BYPASS_ROLE=false


# ── Firebase Admin (verifica los tokens del dashboard, ADR-003) ───────────────
# Firebase Console → Project settings → Service accounts → Generate new private key.
# Mismo proyecto Firebase que sass-back. Se toman del JSON descargado.

# [REQUERIDA] ID del proyecto Firebase.
FIREBASE_PROJECT_ID=<COMPLETAR>

# [REQUERIDA] Email de la service account (termina en .iam.gserviceaccount.com).
FIREBASE_CLIENT_EMAIL=<COMPLETAR>

# [REQUERIDA] Clave privada completa, entre comillas dobles. Los saltos de línea
# del JSON se escriben como \n literal (el código los convierte).
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<COMPLETAR>\n-----END PRIVATE KEY-----\n"


# ── Comunicación con sass-back (dueño de organizaciones y Markets) ────────────
# Regla de arquitectura (00-principios.md): se habla por HTTP/tRPC con URLs de entorno,
# nunca por importación de código. En Railway usar la URL de red privada
# (ej: https://realsass-sass-back.railway.internal).

# [REQUERIDA] URL base de sass-back, sin barra final. La usan el TenantGuard
# (GET /api/v1/auth/organization-access) y el módulo store (resolver tienda por slug).
SASS_BACK_URL=http://localhost:3020

# [OPCIONAL] URL base del servicio de organizaciones. Default http://localhost:3000.
# Normalmente es la misma que SASS_BACK_URL.
ORGANIZATIONS_SERVICE_URL=http://localhost:3020

# [OPCIONAL] Prefijo de la API del servicio de organizaciones. Default /api/v1.
ORGANIZATIONS_SERVICE_PREFIX=/api/v1

# [OPCIONAL] Segundos que se cachea el acceso usuario→organización. Default 30.
# Más alto = menos llamadas a sass-back, pero los cambios de permisos tardan más en verse.
CONFIG_CACHE_TTL_ORG_ACCESS=30

# [REQUERIDA] Clave compartida para las llamadas servicio-a-servicio (ADR-013).
# Viaja en el header x-internal-api-key hacia sass-back (resolveMarket en el checkout).
# Debe tener el MISMO valor que INTERNAL_API_KEY de sass-back. Mínimo 32 caracteres en producción.
# Rotación sin caída: recibir con "nueva,vieja" (sass-back), enviar con la primera (acá), y al final retirar la vieja.
INTERNAL_API_KEY=<COMPLETAR>


# ── Redis (cache del acceso a organizaciones) ─────────────────────────────────

# [OPCIONAL] "true" activa el cache en Redis y requiere REDIS_URL. Cualquier otro valor =
# modo no-op: sin intentos de conexión y con fallback a cache en memoria del proceso
# (no se comparte entre réplicas). Default: desactivado.
REDIS_ENABLED=false

# [OPCIONAL] URL de Redis. Solo se usa si REDIS_ENABLED=true. Default redis://localhost:6379.
REDIS_URL=redis://localhost:6379
