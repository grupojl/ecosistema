# realsass-ecommerce-back — variables de entorno requeridas
# Copiar a .env y completar con valores reales (nunca commitear .env)

# ── Base de datos ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/realsass_ecommerce_db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=tu-proyecto-firebase
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@tu-proyecto.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Comunicación con sass-back ────────────────────────────────────────────────
# URL interna Railway en prod: http://realsass-sass-back.railway.internal:3000
SASS_BACK_INTERNAL_URL=http://localhost:3000

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://tu-dashboard.railway.app,https://tu-ecommerce-front.railway.app

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
