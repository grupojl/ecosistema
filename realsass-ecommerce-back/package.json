    "@prisma/client": "catalog:",
    "@prisma/client-runtime-utils": "catalog:",
    "@real/auth-server": "workspace:*",
    "@real/trpc": "workspace:*",
    "@trpc/server": "catalog:",
    "@willsoto/nestjs-prometheus": "catalog:",
    "bcryptjs": "catalog:",
    "bullmq": "catalog:",
    "cookie-parser": "catalog:",
    "dotenv": "catalog:",
    "firebase-admin": "catalog:",
    "helmet": "catalog:",
