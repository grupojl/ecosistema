# ══════════════════════════════════════════════════════════════════════════════
# realsass-sass-back — identidad, organizaciones, colaboradores y configuración
# ══════════════════════════════════════════════════════════════════════════════
# Local:       cp .env.example .env   y completar los valores <COMPLETAR>.
# Producción:  cargar estas variables en Railway (Variables del servicio).
#              NUNCA commitear el .env.
#
# [REQUERIDA] el servicio no arranca, o falla al primer uso, si falta.
# [OPCIONAL]  tiene un valor por defecto; se muestra el default.
#
# Los comentarios van en su propia línea (no al lado del valor): `docker --env-file`
# no soporta comentarios en línea y los tomaría como parte del valor.
# ══════════════════════════════════════════════════════════════════════════════


# ── Aplicación ────────────────────────────────────────────────────────────────

# [OPCIONAL] Entorno. En "production" los logs salen en JSON y el nivel por defecto es "info".
NODE_ENV=development

# [OPCIONAL] Puerto HTTP. Default 3000. Railway lo inyecta solo; la imagen Docker lo fija en 3000.
PORT=3000

# [REQUERIDA] Orígenes permitidos por CORS, separados por coma y SIN barra final.
# Deben ser los fronts que llaman a este back (sass-front y dashboard-front).
# Sin esta variable el servidor lanza un error y no arranca: se usa con cookies
# HttpOnly (credentials: true) y el comodín "*" sería una vulnerabilidad.
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002

# [OPCIONAL] Nivel de log de pino: trace | debug | info | warn | error.
# Default: debug fuera de producción, info en producción.
LOG_LEVEL=debug


# ── Base de datos ─────────────────────────────────────────────────────────────

# [REQUERIDA] PostgreSQL de este servicio. Lo lee la app y prisma.config.ts
# (prisma migrate deploy corre en el entrypoint del contenedor antes de arrancar).
# Cada servicio tiene su PROPIA base: no compartir con ecommerce-back.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/realsass_sass?schema=public


# ── Firebase Admin (verifica tokens y crea session cookies, ADR-003/004) ──────
# Firebase Console → Project settings → Service accounts → Generate new private key.
# Se toman del JSON descargado.

# [REQUERIDA] ID del proyecto Firebase.
FIREBASE_PROJECT_ID=<COMPLETAR>

# [REQUERIDA] Email de la service account (termina en .iam.gserviceaccount.com).
FIREBASE_CLIENT_EMAIL=<COMPLETAR>

# [REQUERIDA] Clave privada completa, entre comillas dobles. Los saltos de línea
# del JSON se escriben como \n literal (el código los convierte).
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<COMPLETAR>\n-----END PRIVATE KEY-----\n"


# ── Seguridad ─────────────────────────────────────────────────────────────────

# [REQUERIDA] Clave maestra AES-256-GCM que cifra los secretos de las organizaciones
# (módulo config-secrets). Debe ser 32 bytes en hexadecimal = exactamente 64 caracteres.
# Generar con:  openssl rand -hex 32
# Si se pierde o se cambia NO se pueden descifrar los secretos ya guardados.
CONFIG_MASTER_KEY=<COMPLETAR>

# [REQUERIDA] Clave compartida para las llamadas servicio-a-servicio y del superadmin
# (grupojl-control, ADR-013). Viaja en el header x-internal-api-key.
# Debe tener el MISMO valor en ecommerce-back y en el superadmin.
# Sin ella los endpoints /internal/* responden 403.
INTERNAL_API_KEY=<COMPLETAR>


# ── Integración con fronts ────────────────────────────────────────────────────

# [OPCIONAL] URL del dashboard de colaboradores. Es el destino por defecto del
# redirect de POST /auth/firebase-sso cuando el body no trae `redirectTo`. Default "/".
DASHBOARD_FRONT_URL=http://localhost:3002


# ── Redis (cache de configuración) ────────────────────────────────────────────

# [OPCIONAL] "true" activa el cache en Redis. Cualquier otro valor = modo no-op
# (sin intentos de conexión). Default: desactivado.
REDIS_ENABLED=false

# [OPCIONAL] URL de Redis. Solo se usa si REDIS_ENABLED=true.
# OJO: la cola BullMQ de webhooks (módulo config-webhooks) hoy NO lee esta variable:
# se conecta al Redis por defecto de BullMQ (localhost:6379). Para producción hay que
# cablear su conexión a REDIS_URL (deuda DT-ENV-02 en .claude/roadmap/deuda-tecnica.md).
REDIS_URL=redis://localhost:6379


# ── Webhooks salientes ────────────────────────────────────────────────────────

# [OPCIONAL] Timeout, en milisegundos, de cada entrega de webhook. Default 5000.
WEBHOOK_DELIVERY_TIMEOUT=5000

# [OPCIONAL] Reintentos de una entrega fallida (backoff de BullMQ). Default 3.
WEBHOOK_MAX_RETRIES=3


# ── Observabilidad (OpenTelemetry) ────────────────────────────────────────────

# [OPCIONAL] Nombre del servicio en las trazas. Default "realsass-sass-back".
OTEL_SERVICE_NAME=realsass-sass-back

# [OPCIONAL] Endpoint OTLP/HTTP de trazas (path completo, con /v1/traces).
# Si se deja vacío o comentado, el servicio NO exporta trazas.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
