# realsass-sass-back — variables de entorno requeridas
# Copiar a .env y completar con valores reales (nunca commitear .env)

# ── Base de datos ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/realsass_sass_db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=tu-proyecto-firebase
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@tu-proyecto.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── CORS ──────────────────────────────────────────────────────────────────────
# Lista separada por comas de orígenes permitidos
ALLOWED_ORIGINS=https://tu-sass-front.railway.app,https://tu-dashboard.railway.app

# ── Auth ──────────────────────────────────────────────────────────────────────
# Duración de la session cookie en milisegundos (14 días por defecto)
SESSION_COOKIE_DURATION_MS=1209600000

# ── Internal API (para superadmin grupojl-control) ────────────────────────────
INTERNAL_API_KEY=generar-con-openssl-rand-hex-32

# ── Crypto (para config-secrets) ──────────────────────────────────────────────
ENCRYPTION_KEY=generar-con-openssl-rand-hex-32

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
