# ══════════════════════════════════════════════════════════════════════════════
# realsass-sass-front — landing pública y panel del dueño (/profile, /settings)
# ══════════════════════════════════════════════════════════════════════════════
# Local:       cp .env.example .env.local   y completar los valores <COMPLETAR>.
# Producción:  cargar en Railway como **Build Variables** (no alcanza con Runtime):
#              Next.js incrusta las NEXT_PUBLIC_* en el JavaScript al compilar, así que
#              cambiarlas después del build no tiene efecto. El Dockerfile las recibe
#              como ARG. Las que NO llevan el prefijo NEXT_PUBLIC_ son de servidor y se
#              leen en runtime.
#
# Las URLs son la BASE del servicio, sin barra final y SIN /api/v1: los clientes tRPC
# agregan ellos mismos /api/v1/trpc.
#
# [REQUERIDA] la app no funciona si falta.
# [OPCIONAL]  la función asociada queda deshabilitada o usa un fallback.
# Los comentarios van en su propia línea (no al lado del valor).
# ══════════════════════════════════════════════════════════════════════════════


# ── Backend (tRPC) ────────────────────────────────────────────────────────────

# [REQUERIDA] URL pública de realsass-sass-back. La usan el AuthProvider (sync, cookie de
# sesión), el cliente tRPC del navegador y el SSO hacia el dashboard.
# También se agrega a la CSP (connect-src) en next.config.mjs.
NEXT_PUBLIC_SASS_BACK_URL=http://localhost:3000

# [OPCIONAL, solo servidor] URL INTERNA de sass-back para el prefetch de los Server
# Components (/profile). El tema público (lib/config-client.ts) la usa solo si falta
# NEXT_PUBLIC_SASS_BACK_URL. En Railway usar la red privada
# (ej: https://realsass-sass-back.railway.internal). Si falta, el prefetch cae a
# NEXT_PUBLIC_API_URL. Variable de runtime: no necesita ARG.
SASS_BACK_URL=http://localhost:3000

# [OPCIONAL] Fallback legado de SASS_BACK_URL en el servidor y origen extra de la CSP.
# Dejar vacía si SASS_BACK_URL está definida.
# NEXT_PUBLIC_API_URL=http://localhost:3000


# ── Otros fronts ──────────────────────────────────────────────────────────────

# [REQUERIDA para el SSO] URL pública del dashboard de colaboradores. "Abrir dashboard"
# redirige ahí con un custom token de Firebase (/auth/sso). También entra en la CSP.
NEXT_PUBLIC_DASHBOARD_FRONT_URL=http://localhost:3002


# ── Firebase (cliente web) ────────────────────────────────────────────────────
# Firebase Console → Project settings → General → Your apps → Web app → SDK config.
# Mismo proyecto que usa sass-back para verificar los tokens.
# Para el login con Apple y Facebook hay que habilitar esos proveedores en
# Firebase Console → Authentication → Sign-in method.

# [REQUERIDA]
NEXT_PUBLIC_FIREBASE_API_KEY=<COMPLETAR>

# [OPCIONAL] Default <projectId>.firebaseapp.com.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<COMPLETAR>

# [REQUERIDA] También se usa para armar la CSP (next.config.mjs).
NEXT_PUBLIC_FIREBASE_PROJECT_ID=<COMPLETAR>

# [OPCIONAL] Default <projectId>.appspot.com.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=<COMPLETAR>

# [OPCIONAL]
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=<COMPLETAR>

# [OPCIONAL]
NEXT_PUBLIC_FIREBASE_APP_ID=<COMPLETAR>
