# ════════════════════════════════════════════════════════════════════════════════
# FIREBASE — Frontend (todas deben empezar con NEXT_PUBLIC_)
# Firebase Console → Project Settings → General → Your apps → Web app
# ════════════════════════════════════════════════════════════════════════════════
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc123

# ════════════════════════════════════════════════════════════════════════════════
# BACKEND — Sistema 1 (real-back)
# ════════════════════════════════════════════════════════════════════════════════
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# ════════════════════════════════════════════════════════════════════════════════
# CONFIG SERVICE — Sistema 3
# URL base del config service. Si no está definido, la landing usa el
# tema hardcodeado (terracota) como fallback.
# El endpoint público GET /config/themes/public/:orgSlug no requiere auth.
# ════════════════════════════════════════════════════════════════════════════════
NEXT_PUBLIC_CONFIG_URL=http://localhost:3005/api/v1
NEXT_PUBLIC_ORG_SLUG=inmobiliaria-san-martin

NEXT_PUBLIC_DASHBOARD_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_DASHBOARD_FRONT_URL=http://localhost:3001