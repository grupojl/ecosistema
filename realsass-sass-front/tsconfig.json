{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "../realsass-sass-back",
    "../realsass-ecommerce-back",
    "../chat-ia-back",
    "../pagos-back",
    "../realsass-sass-back/src/collaborators/dto",
    "../realsass-sass-back/src/config-secrets/dto",
    "../realsass-sass-back/src/config-quotas",
    "../realsass-sass-back/src/config-themes",
    "../realsass-sass-back/src/config-webhooks/dto",
    "../realsass-sass-back/src/config-templates/dto",
    "../realsass-sass-back/src/users/dto",
    "../realsass-sass-back/src/auth/dto"
  ],
  "extends": "../tsconfig.base.json"
}
