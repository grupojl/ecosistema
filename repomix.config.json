{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "output": {
    "filePath": "ecosistema.xml",
    "style": "xml",
    "compress": true,
    "showLineNumbers": false,
    "removeComments": false,
    "removeEmptyLines": true,
    "topFilesLength": 10,
    "instructionFilePath": "repomix.instructions.md"
  },
  "include": [
    "package.json",
    "pnpm-workspace.yaml",
    "tsconfig.base.json",
    "docker-compose.yml",

    "packages/*/package.json",
    "packages/*/tsconfig.json",
    "packages/*/src/**/*.ts",

    "realsass-sass-back/package.json",
    "realsass-sass-back/tsconfig.json",
    "realsass-sass-back/tsconfig.build.json",
    "realsass-sass-back/nest-cli.json",
    "realsass-sass-back/prisma/schema.prisma",
    "realsass-sass-back/src/main.ts",
    "realsass-sass-back/src/**/*.module.ts",
    "realsass-sass-back/src/**/*.controller.ts",
    "realsass-sass-back/src/**/*.service.ts",
    "realsass-sass-back/src/**/*.guard.ts",
    "realsass-sass-back/src/**/*.decorator.ts",
    "realsass-sass-back/src/**/*.dto.ts",
    "realsass-sass-back/src/**/*.types.ts",
    "realsass-sass-back/src/**/*.exception.ts",

    "realsass-ecommerce-back/package.json",
    "realsass-ecommerce-back/tsconfig.json",
    "realsass-ecommerce-back/tsconfig.build.json",
    "realsass-ecommerce-back/nest-cli.json",
    "realsass-ecommerce-back/prisma/schema.prisma",
    "realsass-ecommerce-back/src/main.ts",
    "realsass-ecommerce-back/src/**/*.module.ts",
    "realsass-ecommerce-back/src/**/*.controller.ts",
    "realsass-ecommerce-back/src/**/*.service.ts",
    "realsass-ecommerce-back/src/**/*.guard.ts",
    "realsass-ecommerce-back/src/**/*.decorator.ts",
    "realsass-ecommerce-back/src/**/*.dto.ts",
    "realsass-ecommerce-back/src/**/*.types.ts",
    "realsass-ecommerce-back/src/**/*.exception.ts",

    "realsass-sass-front/package.json",
    "realsass-sass-front/tsconfig.json",
    "realsass-sass-front/next.config.mjs",
    "realsass-sass-front/components.json",
    "realsass-sass-front/app/**/*.tsx",
    "realsass-sass-front/app/**/*.ts",
    "realsass-sass-front/components/**/*.tsx",
    "realsass-sass-front/lib/**/*.ts",
    "realsass-sass-front/hooks/**/*.ts",
    "realsass-sass-front/context/**/*.tsx",
    "realsass-sass-front/types/**/*.ts",

    "realsass-dashboard-front/package.json",
    "realsass-dashboard-front/tsconfig.json",
    "realsass-dashboard-front/next.config.mjs",
    "realsass-dashboard-front/components.json",
    "realsass-dashboard-front/app/**/*.tsx",
    "realsass-dashboard-front/app/**/*.ts",
    "realsass-dashboard-front/components/**/*.tsx",
    "realsass-dashboard-front/lib/**/*.ts",
    "realsass-dashboard-front/hooks/**/*.ts",
    "realsass-dashboard-front/context/**/*.tsx",
    "realsass-dashboard-front/types/**/*.ts",

    "real-ecommerce-front/package.json",
    "real-ecommerce-front/tsconfig.json",
    "real-ecommerce-front/next.config.mjs",
    "real-ecommerce-front/components.json",
    "real-ecommerce-front/app/**/*.tsx",
    "real-ecommerce-front/app/**/*.ts",
    "real-ecommerce-front/components/**/*.tsx",
    "real-ecommerce-front/lib/**/*.ts",
    "real-ecommerce-front/hooks/**/*.ts",
    "real-ecommerce-front/context/**/*.tsx",
    "real-ecommerce-front/types/**/*.ts"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/node_modules/**",
      "**/.next/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.pnpm-store/**",
      "**/coverage/**",
      "**/*.log",
      "**/*.xml",
      "**/*.lock",
      "**/*.tsbuildinfo",
      "**/public/**",
      "**/.git/**",
      "**/__mocks__/**",
      "**/*.spec.ts",
      "**/*.e2e-spec.ts",
      "**/test/**",
      "**/tests/**",
      "**/prisma/migrations/**",
      "**/prisma/seed.ts",
      "**/generated/**",
      "**/components/ui/**"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  }
}